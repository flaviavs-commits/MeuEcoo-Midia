# Desenvolvimento local. Nunca coloque credenciais reais neste arquivo.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Banco e sessão
DATABASE_URL=postgresql://usuario:senha@localhost:5432/meuecoo
AUTH_TOKEN_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
SESSION_SECRET=troque-por-outro-valor-aleatorio-com-pelo-menos-32-caracteres
CRON_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
TOKEN_ENCRYPTION_KEY=troque-por-64-caracteres-hexadecimais
REQUIRE_ENCRYPTED_SECRETS=false
ALLOWED_EMAIL_DOMAINS=exemplo.com
FREE_INTERNAL_EMAIL_DOMAINS=interno.exemplo.com

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/auth/login/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# Publicação e armazenamento
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
ZERNIO_WEBHOOK_SECRET=
ZERNIO_WEBHOOK_URL=
BLOB_ACCESS_MODE=public
BLOB_ALLOWED_HOSTS=seu-store.public.blob.vercel-storage.com
BLOB_PUBLIC_BASE_URL=
BLOB_LEGACY_PUBLIC_FALLBACK=false
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# E-mail e MeuEcoo
GMAIL_USER=
GMAIL_APP_PASSWORD=
MEU_ECOO_URL=
MEU_ECOO_ACCESS_URL=
MEU_ECOO_API_URL=
MEU_ECOO_SERVICE_TOKEN=

# Cobrança
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:5173/app/perfil?billing=success
PAYMENT_CANCEL_URL=http://localhost:5173/app/perfil?billing=cancelled

# Provedores de sistemas avançados (configure pelo menos o necessário ao fluxo)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=

# Push, limites e ajustes opcionais
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:voce@example.com
PG_POOL_MAX=10
PG_QUERY_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
MAX_CONCURRENT_MEDIA_JOBS=3
